{
  "auth": {
    "providers": {
      "anonymous": true
    }
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "vilayaattu",
    "public": ".next-export",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/room",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/room/**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ],
    "redirects": [
      {
        "source": "/room/:code",
        "destination": "/room?code=:code",
        "type": 302
      }
    ]
  }
}
